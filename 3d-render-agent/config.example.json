{
  "llm": {
    "provider_name": "Your LLM Provider",
    "api_format": "openai_responses",
    "api_key_env": "LLM_API_KEY",
    "base_url": "https://api.example.com/v1",
    "model": "your-chat-or-vision-model",
    "timeout": 180
  },
  "image_gen": {
    "provider_name": "BLTCY",
    "api_format": "openai_chat",
    "api_key_env": "IMAGE_API_KEY",
    "base_url": "https://api.bltcy.ai/v1",
    "model": "gpt-image-2",
    "timeout": 300
  },
  "vision": {
    "provider_name": "Your Vision Provider",
    "api_format": "openai_responses",
    "api_key_env": "VISION_API_KEY",
    "base_url": "https://api.example.com/v1",
    "model": "your-vision-model",
    "timeout": 180
  },
  "max_iterations": 3,
  "quality_threshold": 6.5,
  "prompt_strategy_version": "llm_prompt_v1",
  "prompt_overrides": {
    "floorAnalysisSystemPrompt": "",
    "promptGenSystem3dCn": "",
    "promptGenSystemStandardCn": ""
  },
  "image_model_fallbacks": [
    "dall-e-3"
  ],
  "model_switch_after_failures": 2,
  "stop_after_last_model_failures": 2
}
